{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "detail": "Compiles the TypeScript files."
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "watch"
      ],
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ],
      "detail": "Compiles the TypeScript files in watch mode."
    },
    {
      "label": "build integration tests",
      "type": "shell",
      "command": "npm run build && npx tsc -p tests/tsconfig.integration.json",
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
