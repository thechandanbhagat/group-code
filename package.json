{
  "name": "groupcode",
  "displayName": "Group Code",
  "description": "Navigate and organize your codebase by functionality across different file types.",
  "version": "1.9.0",
  "icon": "resources/compass-icon.png",
  "publisher": "thechandanbhagat",
  "repository": "https://github.com/thechandanbhagat/group-code",
  "engines": {
    "vscode": "^1.99.1"
  },
  "activationEvents": [
    "onLanguageModelTool:groupcode_generate",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "group-code-container",
          "title": "Group Code",
          "icon": "resources/compass-icon.svg"
        }
      ]
    },
    "views": {
      "group-code-container": [
        {
          "id": "groupCodeExplorer",
          "name": "Group Code",
          "type": "tree",
          "visibility": "visible"
        },
        {
          "id": "groupCodeFileView",
          "name": "By File",
          "type": "tree",
          "visibility": "collapsed"
        }
      ],
      "explorer": [
        {
          "id": "groupCodeExplorerView",
          "name": "Group Code",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "groupCodeExplorer",
        "contents": "Filter code groups by typing in the search box above.\n[Search Groups](command:groupCode.filterGroups)"
      },
      {
        "view": "groupCodeExplorerView",
        "contents": "Filter code groups by typing in the search box above.\n[Search Groups](command:groupCode.filterGroups)"
      },
      {
        "view": "groupCodeFileView",
        "contents": "Groups organized by file location.\n[Search Groups](command:groupCode.filterGroups)"
      }
    ],
    "commands": [
      {
        "command": "groupCode.filterGroups",
        "title": "Search Groups",
        "category": "Group Code",
        "icon": "$(search)",
        "enablement": "view == groupCodeExplorer || view == groupCodeExplorerView || view == groupCodeFileView"
      },
      {
        "command": "groupCode.clearFilter",
        "title": "Clear Filter",
        "category": "Group Code",
        "icon": "$(clear-all)",
        "enablement": "view == groupCodeExplorer || view == groupCodeExplorerView || view == groupCodeFileView"
      },
      {
        "command": "groupCode.groupCode",
        "title": "Group Code in Current File"
      },
      {
        "command": "groupCode.showGroups",
        "title": "Show Code Groups"
      },
      {
        "command": "groupCode.refreshTreeView",
        "title": "Refresh Code Groups",
        "icon": "$(refresh)"
      },
      {
        "command": "groupCode.navigateToGroup",
        "title": "Navigate to Code Group"
      },
      {
        "command": "groupCode.addCodeGroupDialog",
        "title": "Add Code Group (Dialog)",
        "icon": "$(add)"
      },
      {
        "command": "groupCode.suggestGroupWithAI",
        "title": "Suggest Code Group with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "groupCode.removeAllGroups",
        "title": "Remove All Code Group Comments",
        "category": "Group Code",
        "icon": "$(trash)"
      },
      {
        "command": "groupCode.convertToHierarchy",
        "title": "Convert Flat Groups to Hierarchies",
        "category": "Group Code",
        "icon": "$(arrow-both)"
      },
      {
        "command": "groupCode.rescanWorkspace",
        "title": "Rescan Entire Workspace",
        "category": "Group Code",
        "icon": "$(database)"
      },
      {
        "command": "groupCode.analyzePatterns",
        "title": "Analyze Group Naming Patterns",
        "category": "Group Code",
        "icon": "$(light-bulb)"
      },
      {
        "command": "groupCode.analyzeRefactoring",
        "title": "Analyze Code Group Refactoring",
        "category": "Group Code",
        "icon": "$(wrench)"
      },
      {
        "command": "groupCode.findDuplicates",
        "title": "Find Duplicate/Similar Groups",
        "category": "Group Code",
        "icon": "$(copy)"
      },
      {
        "command": "groupCode.findOrphaned",
        "title": "Find Orphaned Groups",
        "category": "Group Code",
        "icon": "$(archive)"
      },
      {
        "command": "groupCode.setPreferredModel",
        "title": "Set Preferred AI Model",
        "category": "Group Code",
        "icon": "$(hubot)"
      },
      {
        "command": "groupCode.openSettings",
        "title": "Open Settings",
        "category": "Group Code",
        "icon": "$(settings-gear)"
      },
      {
        "command": "groupCode.toggleFavorite",
        "title": "Toggle Favorite",
        "category": "Group Code",
        "icon": "$(star)"
      },
      {
        "command": "groupCode.renameGroup",
        "title": "Rename Group",
        "category": "Group Code",
        "icon": "$(edit)"
      },
      {
        "command": "groupCode.quickAddGroup",
        "title": "Add to Group...",
        "category": "Group Code",
        "icon": "$(add)",
        "enablement": "editorHasSelection || editorTextFocus"
      }
    ],
    "chatParticipants": [
      {
        "id": "groupcode",
        "name": "groupcode",
        "description": "Helps you organize and navigate code groups in your workspace",
        "isSticky": true,
        "commands": [
          {
            "name": "generate",
            "description": "AI-powered: Add @group comments where missing. Use 'update' to replace existing, 'workspace' for all files"
          },
          {
            "name": "scan",
            "description": "Scan active file for code groups. Use '/scan workspace' to scan all files"
          },
          {
            "name": "suggest",
            "description": "Get AI suggestions for grouping selected code"
          },
          {
            "name": "list",
            "description": "Show all code groups in the workspace"
          },
          {
            "name": "find",
            "description": "Search for specific code groups"
          },
          {
            "name": "navigate",
            "description": "Navigate to a specific code group"
          },
          {
            "name": "refresh",
            "description": "Rescan all files for code groups"
          },
          {
            "name": "refactor",
            "description": "Analyze code groups for refactoring opportunities"
          },
          {
            "name": "duplicates",
            "description": "Find duplicate or similar group names"
          },
          {
            "name": "orphaned",
            "description": "Find orphaned or unused groups"
          }
        ]
      }
    ],
    "grammars": [
      {
        "scopeName": "groupcode.injection",
        "path": "./syntaxes/groupcode.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.js",
          "source.jsx",
          "source.tsx",
          "source.python",
          "source.java",
          "source.cs",
          "source.cpp",
          "source.c",
          "source.go",
          "source.rust",
          "source.ruby",
          "source.php",
          "source.swift",
          "source.kotlin",
          "source.dart",
          "source.scala",
          "text.html.basic",
          "source.css",
          "source.scss",
          "source.less",
          "source.yaml",
          "source.json"
        ]
      }
    ],
    "keybindings": [
      {
        "command": "groupCode.showGroups",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "groupCode.addCodeGroupDialog",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "groupCode.renameGroup",
        "key": "f2",
        "when": "focusedView == groupCodeExplorer || focusedView == groupCodeExplorerView"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "groupCode.quickAddGroup",
          "group": "1_groupcode@1",
          "when": "editorHasSelection || editorTextFocus"
        },
        {
          "command": "groupCode.groupCode",
          "group": "1_groupcode@2"
        },
        {
          "command": "groupCode.showGroups",
          "group": "1_groupcode@3"
        },
        {
          "command": "groupCode.addCodeGroupDialog",
          "group": "1_groupcode@4"
        },
        {
          "command": "groupCode.suggestGroupWithAI",
          "group": "1_groupcode@5"
        }
      ],
      "explorer/context": [],
      "view/item/context": [
        {
          "command": "groupCode.toggleFavorite",
          "when": "view == groupCodeExplorer && viewItem == hierarchyNode || view == groupCodeExplorerView && viewItem == hierarchyNode",
          "group": "inline@1"
        },
        {
          "command": "groupCode.toggleFavorite",
          "when": "view == groupCodeExplorer && viewItem == hierarchyNodeFavorite || view == groupCodeExplorerView && viewItem == hierarchyNodeFavorite",
          "group": "inline@1"
        },
        {
          "command": "groupCode.toggleFavorite",
          "when": "view == groupCodeExplorer && viewItem == hierarchyNode || view == groupCodeExplorerView && viewItem == hierarchyNode",
          "group": "favorites@1"
        },
        {
          "command": "groupCode.toggleFavorite",
          "when": "view == groupCodeExplorer && viewItem == hierarchyNodeFavorite || view == groupCodeExplorerView && viewItem == hierarchyNodeFavorite",
          "group": "favorites@1"
        },
        {
          "command": "groupCode.renameGroup",
          "when": "view == groupCodeExplorer && viewItem == hierarchyNode || view == groupCodeExplorerView && viewItem == hierarchyNode",
          "group": "edit@1"
        },
        {
          "command": "groupCode.renameGroup",
          "when": "view == groupCodeExplorer && viewItem == hierarchyNodeFavorite || view == groupCodeExplorerView && viewItem == hierarchyNodeFavorite",
          "group": "edit@1"
        }
      ],
      "view/title": [
        {
          "command": "groupCode.filterGroups",
          "when": "view == groupCodeExplorer || view == groupCodeExplorerView",
          "group": "navigation@0"
        },
        {
          "command": "groupCode.clearFilter",
          "when": "view == groupCodeExplorer || view == groupCodeExplorerView",
          "group": "navigation@0"
        },
        {
          "command": "groupCode.refreshTreeView",
          "when": "view == groupCodeExplorer || view == groupCodeExplorerView",
          "group": "navigation@1"
        },
        {
          "command": "groupCode.openSettings",
          "when": "view == groupCodeExplorer || view == groupCodeExplorerView",
          "group": "navigation@2"
        },
        {
          "command": "groupCode.filterGroups",
          "when": "view == groupCodeFileView",
          "group": "navigation@0"
        },
        {
          "command": "groupCode.clearFilter",
          "when": "view == groupCodeFileView",
          "group": "navigation@0"
        },
        {
          "command": "groupCode.refreshTreeView",
          "when": "view == groupCodeFileView",
          "group": "navigation@1"
        },
        {
          "command": "groupCode.openSettings",
          "when": "view == groupCodeFileView",
          "group": "navigation@2"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "groupcode_generate",
        "displayName": "Generate Code Groups",
        "toolReferenceName": "groupcode",
        "canBeReferencedInPrompt": true,
        "userDescription": "Analyze code or add functionality annotations.",
        "modelDescription": "Analyze, generate or suggest @group comments. Generated annotations preserve executable source.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "analyze",
                "generate",
                "suggest"
              ]
            },
            "code": {
              "type": "string"
            },
            "filePath": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json && node scripts/build.js",
    "build:tests": "tsc -p ./tests/tsconfig.test.json && node -e \"const fs=require('fs'),p=require('path');const d=p.join('out','tests','node_modules','vscode');fs.mkdirSync(d,{recursive:true});fs.writeFileSync(p.join(d,'index.js'),'module.exports=require(\\'../../tests/mocks/vscode\\');')\"",
    "pretest": "npm run build && npm run build:tests",
    "test": "mocha --config tests/.mocharc.yml",
    "watch": "node scripts/build.js --watch",
    "start": "code --extensionDevelopmentPath=.",
    "vscode:prepublish": "npm run build",
    "test:integration": "tsc -p tests/tsconfig.integration.json && node scripts/test-host.js",
    "test:package": "node scripts/check-package.js",
    "package": "vsce package --no-dependencies",
    "pretest:integration": "npm run build"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.11.6",
    "@types/vscode": "1.99.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "ts-loader": "^9.2.6",
    "typescript": "^4.4.3",
    "yauzl": "^2.10.0"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Group Code currently requires a filesystem workspace on the desktop or remote extension host."
    }
  },
  "dependencies": {
    "ignore": "^7.0.5"
  }
}
